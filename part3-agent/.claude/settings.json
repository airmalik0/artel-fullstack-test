{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_MODEL": "deepseek-flash[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash",
    "API_TIMEOUT_MS": "600000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "900000"
  },
  "skipWebFetchPreflight": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "default",
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Agent",
      "Bash(./scripts/step.sh *)",
      "Bash(./scripts/diag.sh *)",
      "Bash(./scripts/free-port.sh *)",
      "Bash(./scripts/verdict.sh *)",
      "Read(./CLAUDE.md)",
      "Read(./scripts/**)",
      "Read(./output/*/steps/**)",
      "Read(./output/*/verdict.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.agent-home/**)",
      "Read(./secrets/**)",
      "Read(./output/*/client/**)",
      "Read(**/*.token)",
      "Read(**/*_ed25519)",
      "Edit(./.claude/**)",
      "Edit(./.env*)",
      "Edit(./scripts/**)",
      "Edit(./start.sh)",
      "Edit(./.cache/**)",
      "Bash(tmux *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "./scripts/step.sh *",
      "./scripts/diag.sh *",
      "./scripts/free-port.sh *",
      "./scripts/verdict.sh *"
    ],
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.agent-home",
        "./secrets",
        "./output"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/verdict_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
