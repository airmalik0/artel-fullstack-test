# Скопируй в .env и заполни. .env в git и в архив не попадает, агенту чтение запрещено.

# Токен DeepSeek (обязательно). Можно не писать сюда, а экспортировать DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=

# Ключ, с которым агент заходит на целевой сервер. Создаётся tools/new-target-key.sh.
TARGET_SSH_KEY=secrets/target_ed25519
# Под кем первый вход на чистый сервер. После укрепления root закрыт, вход под DEPLOY_USER.
TARGET_SSH_USER=root
DEPLOY_USER=vpnops

# Сайт, под который маскируется Reality: TLS 1.3, X25519, HTTP/2, не за CDN с ограничениями.
REALITY_SNI=www.microsoft.com
